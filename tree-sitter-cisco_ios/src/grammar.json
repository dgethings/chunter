{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cisco_ios",
  "rules": {
    "configuration_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_section"
        }
      ]
    },
    "_section": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "system_section"
        }
      ]
    },
    "system_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "hostname_statement"
        }
      ]
    },
    "hostname_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "hostname"
        },
        {
          "type": "SYMBOL",
          "name": "value"
        }
      ]
    },
    "value": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}