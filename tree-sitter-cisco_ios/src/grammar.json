{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cisco_ios",
  "rules": {
    "configuration_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "SYMBOL",
          "name": "_running_version"
        },
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "service_section"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "archive_section"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "async_bootp_section"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "line_section"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "hostname_section"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_alias_section"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_running_version": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "STRING",
          "value": "version"
        },
        {
          "type": "SYMBOL",
          "name": "running_version"
        }
      ]
    },
    "running_version": {
      "type": "PATTERN",
      "value": "[a-z0-9\\.-]+"
    },
    "service_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_configured_version"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "service_statements"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "_configured_version": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "version"
        },
        {
          "type": "SYMBOL",
          "name": "configured_version"
        }
      ]
    },
    "configured_version": {
      "type": "PATTERN",
      "value": "[a-z0-9\\.-]+"
    },
    "service_statements": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "no"
        },
        {
          "type": "STRING",
          "value": "service"
        },
        {
          "type": "STRING",
          "value": "pad"
        }
      ]
    },
    "hostname_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "hostname"
        },
        {
          "type": "SYMBOL",
          "name": "value"
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "value": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9]+"
    },
    "_alias_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "alias_statement"
          }
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "alias_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "alias"
        },
        {
          "type": "SYMBOL",
          "name": "mode"
        },
        {
          "type": "SYMBOL",
          "name": "alias"
        },
        {
          "type": "SYMBOL",
          "name": "command"
        }
      ]
    },
    "mode": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "exec"
        },
        {
          "type": "STRING",
          "value": "foo"
        }
      ]
    },
    "alias": {
      "type": "PATTERN",
      "value": "[a-z]+"
    },
    "command": {
      "type": "PATTERN",
      "value": "[a-z0-9 ]+"
    },
    "line_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "line"
        },
        {
          "type": "SYMBOL",
          "name": "line_type"
        },
        {
          "type": "SYMBOL",
          "name": "activation_character"
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "line_type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "console"
        },
        {
          "type": "STRING",
          "value": "tty0"
        }
      ]
    },
    "activation_character": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "activation-character"
        },
        {
          "type": "SYMBOL",
          "name": "ascii_value"
        }
      ]
    },
    "ascii_value": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "archive_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "archive"
        },
        {
          "type": "SYMBOL",
          "name": "_archive_path"
        },
        {
          "type": "STRING",
          "value": "end"
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "_archive_path": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "path"
        },
        {
          "type": "SYMBOL",
          "name": "file_path"
        }
      ]
    },
    "file_path": {
      "type": "PATTERN",
      "value": "[a-z0-9:\\/]+"
    },
    "async_bootp_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "async-bootp"
        },
        {
          "type": "SYMBOL",
          "name": "async_bootp_tag"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "async_bootp_hostname"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "async_bootp_data"
        },
        {
          "type": "STRING",
          "value": "!"
        }
      ]
    },
    "async_bootp_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "bootfile"
        }
      ]
    },
    "async_bootp_hostname": {
      "type": "PATTERN",
      "value": "\\:[a-z0-9\\.]+"
    },
    "async_bootp_data": {
      "type": "PATTERN",
      "value": "\"[a-z]+\""
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [
    [
      "_alias_section",
      "service_section"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}