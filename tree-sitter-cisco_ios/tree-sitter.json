{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cisco_ios",
      "camelcase": "CiscoIos",
      "title": "Cisco IOS",
      "scope": "source.cisco_ios",
      "file-types": [
